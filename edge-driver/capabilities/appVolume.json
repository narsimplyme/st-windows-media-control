{
  "name": "App Volume",
  "attributes": {
    "appName": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 160
          }
        },
        "additionalProperties": false,
        "required": [
          "value"
        ]
      }
    },
    "volume": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false,
        "required": [
          "value"
        ]
      }
    }
  },
  "commands": {
    "setVolume": {
      "name": "setVolume",
      "arguments": [
        {
          "name": "volume",
          "optional": false,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      ]
    }
  }
}